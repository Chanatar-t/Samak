DATABASE_URL=postgres://postgres:dev@localhost:5432/jobtracker
# npx auth secret
AUTH_SECRET=
# Google Cloud Console > OAuth client (Web), redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL=you@gmail.com

# Phase 1: Gmail over IMAP. Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# any random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
