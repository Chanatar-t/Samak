# Copied to .env.local by `npm run setup` (which also fills AUTH_SECRET and APP_PASSWORD).

# Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:dev@localhost:5432/jobtracker
# Random string: signs the login cookie and encrypts the saved Gmail app password. Changing it = reconnect Gmail.
AUTH_SECRET=
# Password for the web login
APP_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Owner id for all data. Leave empty for a fresh install. If you previously logged in with Google, set it to that
# email so existing rows stay visible. Also the only email allowed when Google login is on.
ALLOWED_EMAIL=
# Google login instead of / besides the password. Needs a Google Cloud OAuth client (Web),
# redirect URI http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gmail is normally connected in the app (Settings). These are a fallback, e.g. for scripts/gmail-peek.mts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Claude reads emails the built-in rules don't recognise. Without it those go to Inbox for review.
ANTHROPIC_API_KEY=
# Only when deployed with Vercel Cron: sent as a Bearer token to /api/cron/sync
CRON_SECRET=
